APP_ENV=production
APP_URL=https://life.snowmoon1824.top
APP_TIMEZONE=Europe/Berlin
SESSION_NAME=life_dashboard_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=life
DB_USERNAME=life
DB_PASSWORD="replace-with-bt-mysql-password"

ADMIN_USERNAME=sakura
ADMIN_PASSWORD="replace-with-a-strong-login-password"
ADMIN_EMAIL="you@example.com"
ADMIN_DISPLAY_NAME=Sakura

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME="you@example.com"
SMTP_PASSWORD="replace-with-smtp-authorization-code"
SMTP_FROM_EMAIL="you@example.com"
SMTP_FROM_NAME="人生看板"

WEB_PUSH_SUBJECT="https://life.snowmoon1824.top"
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

OPENAI_API_KEY="sk-proj-replace-with-your-api-key"
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_REASONING_EFFORT="low"
OPENAI_DAILY_LIMIT=2
OPENAI_TIMEOUT_SECONDS=90
