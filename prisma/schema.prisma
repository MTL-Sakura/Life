generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskCategory {
  STUDY
  FITNESS
  SLEEP
  LIFE
  CREATION
  WORK
  CUSTOM
}

enum TaskDifficulty {
  EASY
  NORMAL
  HARD
  EPIC
}

enum TaskStatus {
  TODO
  DONE
  SKIPPED
}

enum CompletionTier {
  STARTER
  STANDARD
  BONUS
}

enum RepeatRule {
  NONE
  DAILY
  WEEKLY
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  profile      Profile?
  gardenState  GardenState?
  tasks        TaskTemplate[]
  dailyTasks   DailyTask[]
  checkIns     CheckIn[]
  achievements Achievement[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  level         Int      @default(1)
  xp            Int      @default(0)
  sunlight      Int      @default(0)
  water         Int      @default(0)
  coins         Int      @default(0)
  petals        Int      @default(0)
  focus         Int      @default(0)
  fitness       Int      @default(0)
  order         Int      @default(0)
  creativity    Int      @default(0)
  recovery      Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskTemplate {
  id           String          @id @default(cuid())
  userId       String
  title        String
  category     TaskCategory
  difficulty   TaskDifficulty  @default(NORMAL)
  isActive     Boolean         @default(true)
  starterGoal  String
  standardGoal String
  bonusGoal    String?
  repeatRule   RepeatRule      @default(NONE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTasks   DailyTask[]

  @@index([userId, category])
}

model DailyTask {
  id            String          @id @default(cuid())
  userId        String
  templateId    String?
  date          DateTime
  title         String
  category      TaskCategory
  difficulty    TaskDifficulty  @default(NORMAL)
  starterGoal   String
  standardGoal  String
  bonusGoal     String?
  status        TaskStatus      @default(TODO)
  completedTier CompletionTier?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      TaskTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  checkIns      CheckIn[]

  @@index([userId, date])
}

model CheckIn {
  id              String         @id @default(cuid())
  userId          String
  dailyTaskId     String
  date            DateTime
  tier            CompletionTier
  xpGained        Int
  sunlightGained  Int
  waterGained     Int
  coinsGained     Int
  petalsGained    Int            @default(0)
  attributeGained String
  note            String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTask       DailyTask      @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model GardenState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  treeStage            Int      @default(1)
  treeXp               Int      @default(0)
  gardenLevel          Int      @default(1)
  unlockedDecorations  Json
  placedDecorations    Json
  theme                String   @default("spring")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String    @id @default(cuid())
  userId      String
  key         String
  title       String
  description String
  unlockedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
